# HireInSecond Backend Environment Variables

DB_CONNECTION_STRING=mongodb+srv://<username>:<password>@cluster.mongodb.net/TalentLink
PORT=4000
SECRET_KEY=your_jwt_secret_key

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FRONTEND_URL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP Email
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=support@hireinsecond.com
SMTP_PASS=

# TRAI DLT-Compliant SMS Gateway Configuration (AUTH-03)
# Supported gateways: fast2sms, textlocal, gupshup
SMS_GATEWAY=fast2sms

# Fast2SMS
FAST2SMS_API_KEY=

# TRAI DLT Identifiers
DLT_ENTITY_ID=
DLT_SENDER_ID=HIREIN
DLT_TEMPLATE_ID=

# Alternative SMS Gateways
TEXTLOCAL_API_KEY=
GUPSHUP_USERID=
GUPSHUP_PASSWORD=
